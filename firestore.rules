rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== UTILITY FUNCTIONS =====
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    // ===== USERS COLLECTION =====
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['coins', 'admin', 'welcomeBonusGranted', 'role', 'isGodMode']);
      
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['coins', 'welcomeBonusGranted', 'lastCoinUpdate', 'lastCoinAction']);
    }
    
    // ===== COIN TRANSACTIONS =====
    match /coinTransactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // ===== RECHARGE REQUESTS =====
    match /recharge_requests/{requestId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && hasRequiredFields(['userId', 'amount', 'coins', 'transactionId', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 5000
        && request.resource.data.amount % 10 == 0
        // 🔒 Coins must match the fixed exchange rate (10 BDT = 10,000 coins).
        // The admin approval endpoint recomputes this from `amount` itself and
        // ignores whatever is stored here, but rejecting the write here stops
        // a forged request from ever landing in the pending queue an admin
        // has to review by eye.
        && request.resource.data.coins == (request.resource.data.amount / 10) * 10000;
      allow update, delete: if false;
    }
    
    // ===== SIMULATOR STATE =====
    match /artifacts/{appId}/users/{userId}/simulator/state {
      allow read: if isOwner(userId);

      // 🔒 Trade execution moved server-side (app/api/simulator/trade), which
      // writes via the Admin SDK and bypasses these rules entirely — so the
      // client no longer needs (or gets) ongoing write access. The only
      // client write left is the brand-new-user zero-balance doc created by
      // hooks/useSimulator.ts's onSnapshot "not found" fallback, and it must
      // match that exact zero-value shape.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['balance', 'portfolio', 'totalInvested', 'realizedGainLoss'])
        && request.resource.data.balance == 0
        && request.resource.data.portfolio == []
        && request.resource.data.totalInvested == 0
        && request.resource.data.realizedGainLoss == 0;
      allow update, delete: if false;
    }
    
// ===== TRADE HISTORY =====
    match /artifacts/{appId}/users/{userId}/trade_history/{tradeId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if false;
    }

    // trade_history nested under simulator/state (legacy path fallback)
    match /artifacts/{appId}/users/{userId}/simulator/state/trade_history/{tradeId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if false;
    }
    
    // ===== MARKET DATA (read-only) =====
    match /artifacts/{appId}/public/data/market_info/latest {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    match /artifacts/{appId}/public/data/market_info/categories {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // ===== PUBLIC STATS =====
    match /public_stats/site_stats {
  		allow read: if true;
  		allow update: if isAuthenticated()
    		&& request.resource.data.diff(resource.data).affectedKeys()
        		.hasOnly(['userCount', 'lastUpdated']);
		}
    
    match /public_stats/site_stats/counted_users/{userId} {
      allow create: if isOwner(userId);
      allow read, update, delete: if false;
    }
    
    // ===== SERVER-ONLY COLLECTIONS =====
    match /rate_limits/{identifier} {
      allow read, write, delete: if false;
    }
    
    match /_health/test {
      allow read, write, delete: if false;
    }
    
    // ===== SHORT LINKS =====
    match /short_links/{code} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.creatorId);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
        && request.resource.data.clicks == resource.data.clicks + 1;
    }
    
    // ===== DENY ALL OTHER PATHS =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}