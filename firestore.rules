rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== UTILITY FUNCTIONS =====
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Admin status comes from the signed custom claim only. The previous
    // `get(users/$(uid)).data.role == 'admin'` fallback made admin depend on
    // a mutable Firestore field (and cost a document read on every rule
    // evaluation that referenced it). A custom claim can only be set with
    // service-account credentials, so no client write can forge one.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    // ===== USERS COLLECTION =====
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['coins', 'admin', 'welcomeBonusGranted', 'role', 'isGodMode']);
      
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['coins', 'welcomeBonusGranted', 'lastCoinUpdate', 'lastCoinAction']);
    }
    
    // ===== COIN TRANSACTIONS =====
    match /coinTransactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // ===== RECHARGE REQUESTS =====
    match /recharge_requests/{requestId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && hasRequiredFields(['userId', 'amount', 'coins', 'transactionId', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 5000
        && request.resource.data.amount % 10 == 0
        // 🔒 Coins must match the fixed exchange rate (10 BDT = 10,000 coins).
        // The admin approval endpoint recomputes this from `amount` itself and
        // ignores whatever is stored here, but rejecting the write here stops
        // a forged request from ever landing in the pending queue an admin
        // has to review by eye.
        && request.resource.data.coins == (request.resource.data.amount / 10) * 10000;
      allow update, delete: if false;
    }
    
    // ===== SIMULATOR STATE =====
    match /artifacts/{appId}/users/{userId}/simulator/state {
      allow read: if isOwner(userId);

      // 🔒 Trade execution (app/api/simulator/trade) and brand-new-user
      // state creation (app/api/simulator/ensure-state) both moved
      // server-side and write via the Admin SDK, which bypasses these rules
      // entirely — so the client gets no write access here at all, not even
      // `create`.
      //
      // A `create`-only exception used to exist here for a client-side
      // "onSnapshot says doc not found -> setDoc the zero-value doc"
      // fallback in hooks/useSimulator.ts. That fallback could fire on a
      // stale/cached "not found" read that raced a real trade, and this
      // rule could not tell that apart from a genuinely brand-new user —
      // both are a `create` from the rules engine's point of view the
      // instant the fallback fires before the real doc's existence is
      // reflected locally. Several real accounts got their balance and
      // portfolio wiped to zero this way. The fallback and this exception
      // are both removed; ensure-state now does the same "create if
      // missing" job atomically inside one Admin SDK transaction, closing
      // the client-side race entirely rather than relying on rules to catch
      // it after the fact.
      allow create, update, delete: if false;
    }
    
// ===== TRADE HISTORY =====
    // 🔒 Trade execution (app/api/simulator/trade) writes these records via
    // the Admin SDK, which bypasses these rules entirely — the client never
    // needs to write here. The previous `allow create: if isOwner(userId)`
    // let any authenticated user forge arbitrary trade records (fake
    // symbol/price/quantity/type) directly through the client SDK, with no
    // validation at all; closing it off the same way simulator/state was.
    match /artifacts/{appId}/users/{userId}/trade_history/{tradeId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // trade_history nested under simulator/state (the path the trade route
    // actually writes to — see app/api/simulator/trade/route.ts)
    match /artifacts/{appId}/users/{userId}/simulator/state/trade_history/{tradeId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }
    
    // ===== MARKET DATA (read-only) =====
    match /artifacts/{appId}/public/data/market_info/latest {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    match /artifacts/{appId}/public/data/market_info/categories {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // ===== PUBLIC STATS =====
    match /public_stats/site_stats {
  		allow read: if true;
  		allow update: if isAuthenticated()
    		&& request.resource.data.diff(resource.data).affectedKeys()
        		.hasOnly(['userCount', 'lastUpdated']);
		}
    
    match /public_stats/site_stats/counted_users/{userId} {
      allow create: if isOwner(userId);
      allow read, update, delete: if false;
    }
    
    // ===== SERVER-ONLY COLLECTIONS =====
    match /rate_limits/{identifier} {
      allow read, write, delete: if false;
    }
    
    match /_health/test {
      allow read, write, delete: if false;
    }
    
    // ===== SHORT LINKS =====
    match /short_links/{code} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.creatorId);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
        && request.resource.data.clicks == resource.data.clicks + 1;
    }
    
    // ===== DENY ALL OTHER PATHS =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}