{
  "id": "/",
  "name": "StockSimulatorBD",
  "short_name": "StockSim",
  "description": "Practice trading Dhaka Stock Exchange stocks risk-free with virtual currency.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "orientation": "portrait",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "categories": ["finance", "education", "business"],
  "shortcuts": [
    {
      "name": "Trade",
      "short_name": "Trade",
      "description": "Open the DSE trading terminal",
      "url": "/trade",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Stocks",
      "short_name": "Stocks",
      "description": "Browse the DSE stock directory",
      "url": "/stocks",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Coins",
      "short_name": "Coins",
      "description": "View balance and recharge",
      "url": "/coins",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "/logo/android/launchericon-48x48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "maskable"
    },
